<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.SwimmingAnalysisApplication" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Customize your theme here. -->
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation duration. -->
        <item name="windowSplashScreenBackground">@color/splash_background_color</item>

        <!-- Use windowSplashScreenAnimatedIcon to add either a drawable or an
             animated drawable. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- 브랜드 이미지 설정 (선택 사항) -->
        <!-- <item name="android:windowSplashScreenBrandingImage">@drawable/...</item> -->

        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <!-- Required -->
        <item name="postSplashScreenTheme">@style/Theme.SwimmingAnalysisApplication</item>
    </style>
</resources>
